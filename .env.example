# Set these before the first startup. Use unique, long random passwords.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
OPENMANAGE_ADMIN_USERNAME=admin
OPENMANAGE_ADMIN_PASSWORD=replace-with-a-long-random-admin-password-at-least-12-chars
# true only when HTTPS is used end-to-end or terminated by a trusted reverse proxy.
# For direct plain-HTTP LAN access, false is required but session cookies are not encrypted in transit.
OPENMANAGE_COOKIE_SECURE=false
# Required for SSH enrollment. Generate with: openssl rand -base64 32
# Back this up securely; losing it makes stored SSH private keys unrecoverable.
OPENMANAGE_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
# Default: reachable only from this host (or a reverse proxy on it).
# For LAN access, set the server's specific LAN IP, e.g. 192.168.1.10:8080.
# 0.0.0.0:8080 listens on all IPv4 interfaces; restrict it with a host/router firewall.
OPENMANAGE_PORT=127.0.0.1:8080
# Optional: run the prebuilt image that CI publishes for every merge to main, instead of
# building on this host. Update with: docker compose pull && docker compose up -d
# OPENMANAGE_IMAGE=ghcr.io/nishantjh/openmanage:latest
# Optional: the network's DNS server (a private IPv4 address, e.g. your router's dnsmasq).
# Used to name Wi-Fi devices from reverse DNS when no enrolled DHCP host names them; the
# internal domain is stripped, so phone.internal.lan shows as "phone".
# OPENMANAGE_DNS_SERVER=192.168.1.1
